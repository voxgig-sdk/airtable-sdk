# Guide

guide: {
  metrics: count: entity: 3
  metrics: count: path: 4
  metrics: count: method: 6

  entity: base: {
    path: "/meta/bases": {
      op: list: method: *GET
      op: list: transform: res: *("`body.bases`")|top
    }
  }

  entity: record: {
    path: "/{baseId}/{tableId}": {
      rename: param: "baseId": *"base_id"
      rename: param: "tableId": *"table_id"
      op: create: method: *POST
      op: list: method: *GET
      op: list: transform: res: *("`body.records`")|top
    }
    path: "/{baseId}/{tableId}/{recordId}": {
      rename: param: "baseId": *"base_id"
      rename: param: "recordId": *"record_id"
      rename: param: "tableId": *"table_id"
      op: load: method: *GET
      op: load: transform: res: *("`body.fields`")|top
    }
  }

  entity: table: {
    path: "/meta/bases/{baseId}/tables": {
      rename: param: "baseId": *"base_id"
      op: create: method: *POST
      op: list: method: *GET
      op: list: transform: res: *("`body.tables`")|top
    }
  }

}