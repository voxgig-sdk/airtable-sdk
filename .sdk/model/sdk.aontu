
# Model definitions.
@"@voxgig/apidef/model/apidef.aontu"
@"@voxgig/sdkgen/model/sdkgen.aontu"


# SDK Details.
name: 'airtable'
origin: 'voxgig-sdk'
def: 'airtable-openapi.json'


# "bases" depluralizes ambiguously (cf. "gases"->"gas" vs "bases"->"base");
# the generic rule guesses "bas". Documented per-model override.
main: custom: plurals: bases: 'base'


# API Information
@"api/api-info.aontu"


# SDK Configuration.
@"config.aontu"


# SDK Entities
@"entity/entity-index.aontu"


# SDK Features.
@"feature/feature-index.aontu"
 

# SDK Targets.
@"target/target-index.aontu"


# Operation workflows.
@"flow/flow-index.aontu"


# Seneca provider plugin generates out-of-tree into the sibling repo.
main: kit: target: 'seneca-provider': output: {
  path: '../../seneca/airtable-provider'
  sdkrel: '../../voxgig-sdk/airtable-sdk'
}
