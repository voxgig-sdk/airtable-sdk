# Entity: record

main: kit: entity: record: {

  alias: field: {}

  fields: [
    {
      name: "createdTime"
      req: false
      type: "`$STRING`"
    }
    {
      name: "fields"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "records"
      req: false
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "record"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "base_id"
                orig: "base_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "table_id"
                orig: "table_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/{baseId}/{tableId}"
          parts: [
            "{base_id}"
            "{table_id}"
          ]
          rename: {
            param: {
              baseId: "base_id"
              tableId: "table_id"
            }
          }
          select: {
            exist: [
              "base_id"
              "table_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "base_id"
                orig: "base_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "table_id"
                orig: "table_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/{baseId}/{tableId}"
          parts: [
            "{base_id}"
            "{table_id}"
          ]
          rename: {
            param: {
              baseId: "base_id"
              tableId: "table_id"
            }
          }
          select: {
            exist: [
              "base_id"
              "table_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.records`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "base_id"
                orig: "base_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "record_id"
                orig: "record_id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "table_id"
                orig: "table_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/{baseId}/{tableId}/{recordId}"
          parts: [
            "{base_id}"
            "{table_id}"
            "{record_id}"
          ]
          rename: {
            param: {
              baseId: "base_id"
              recordId: "record_id"
              tableId: "table_id"
            }
          }
          select: {
            exist: [
              "base_id"
              "record_id"
              "table_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.fields`"
          }
        }
      ]
    }
  }



}
